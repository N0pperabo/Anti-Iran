{
  "$defs": {
    "ActionType": {
      "description": "Supported automation action types.",
      "enum": [
        "click",
        "double_click",
        "right_click",
        "type",
        "clear",
        "key_press",
        "key_down",
        "key_up",
        "mouse_move",
        "scroll",
        "wait",
        "select_option",
        "check",
        "uncheck",
        "screenshot",
        "extract_text",
        "extract_attribute",
        "navigate",
        "go_back",
        "go_forward",
        "reload"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "CheckAction": {
      "properties": {
        "id": {
          "description": "Unique identifier for the action",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ActionType",
          "default": "check"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable description",
          "title": "Description"
        },
        "enabled": {
          "default": true,
          "description": "Whether this action should be executed",
          "title": "Enabled",
          "type": "boolean"
        },
        "timeout_ms": {
          "default": 10000,
          "description": "Max execution timeout in milliseconds",
          "title": "Timeout Ms",
          "type": "integer"
        },
        "retry_count": {
          "default": 1,
          "description": "Number of retries if selector fails",
          "title": "Retry Count",
          "type": "integer"
        },
        "fallback_selectors": {
          "description": "Alternative selectors to try if primary fails",
          "items": {
            "type": "string"
          },
          "title": "Fallback Selectors",
          "type": "array"
        },
        "selector": {
          "description": "Primary CSS or XPath selector",
          "title": "Selector",
          "type": "string"
        }
      },
      "required": [
        "id",
        "selector"
      ],
      "title": "CheckAction",
      "type": "object"
    },
