# GitHub Configuration
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
GITHUB_USERNAME=your-username
GITHUB_REPO_OWNER=your-username-or-org
GITHUB_REPO_NAME=your-private-repo
GITHUB_DEFAULT_BRANCH=main

# Browser State Security Key (Fernet AES Base64 key)
# Also set this secret in your GitHub Private Repository Secrets as 'BROWSER_STATE_KEY'
BROWSER_STATE_KEY=yourFernetEncryptionKeyBase64==

# UI & Runtime Settings
APP_THEME=dark
LOG_LEVEL=INFO
